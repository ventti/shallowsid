rules_version = '2';

// ShallowSID sync: one document per sync key, at vaults2/<64 hex id>.
// The id and a write secret are derived from a 128-bit key that only the
// user's devices know, and the content is encrypted in the browser, so there
// are no accounts. Knowing the id lets you read the ciphertext, nothing more:
// like lists/ below, `owner` is sha256(token_n) and an update must carry
// proof = token_n, bump n and store owner = sha256(token_n+1), where token_n
// comes from the write secret. Deleting takes a proven update that sets
// `del` first. Listing is forbidden, so ids can't be discovered.
// v 2 marks a "moved" record, left when a device is removed from sync (see
// js/sync.js). It can't be changed or deleted, so the removed device, which
// still knows the old key, can't hide from the others where the data went.
// vaults/ holds records from before write proofs: read-only, for migration.
service cloud.firestore {
  match /databases/{database}/documents {
    function validVaultId(id) {
      return id.matches('^[0-9a-f]{64}$');
    }

    match /vaults/{id} {
      allow get: if validVaultId(id);
      allow list, create, update, delete: if false;
    }

    match /vaults2/{id} {
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['c', 'iv', 'v', 'expireAt', 'owner', 'n', 'proof', 'del'])
          && d.c is string && d.c.size() <= 500000
          && d.iv is string && d.iv.size() == 16
          && d.v is int
          && d.expireAt is timestamp
          && d.expireAt > request.time
          && d.expireAt < request.time + duration.value(400, 'd')
          && d.owner is string && d.owner.matches('^[0-9a-f]{64}$')
          && d.n is int
          && (!('del' in d) || d.del is bool);
      }

      function proven() {
        let d = request.resource.data;
        return d.proof is string && d.proof.matches('^[0-9a-f]{64}$')
          && hashing.sha256(d.proof).toHexString().lower() == resource.data.owner
          && d.n == resource.data.n + 1;
      }

      allow get: if validVaultId(id);
      allow list: if false;
      allow create: if validVaultId(id) && validData()
        && request.resource.data.n == 0
        && !('proof' in request.resource.data)
        && !('del' in request.resource.data);
      allow update: if validVaultId(id) && validData() && proven()
        && resource.data.v < 2
        && resource.data.get('del', false) == false;
      allow delete: if validVaultId(id) && resource.data.get('del', false) == true;
    }

    // Unlisted playlists: lists/<12-char id>, readable by anyone with the link.
    // Only the owner can change one: `owner` is sha256(token_n), and an update
    // must carry proof = token_n and store owner = sha256(token_n+1), so a proof
    // that becomes visible after use is useless for the next update.
    // "Stop sharing" is such an update with empty content; there is no delete.
    match /lists/{id} {
      function validListId() {
        return id.matches('^[a-hj-np-z2-9]{12}$');
      }

      function validList(d) {
        return d.d is string && d.d.size() <= 200000
          && d.owner is string && d.owner.matches('^[0-9a-f]{64}$')
          && d.n is int
          && d.v is int;
      }

      allow get: if validListId();
      allow list, delete: if false;
      allow create: if validListId()
        && request.resource.data.keys().hasOnly(['d', 'owner', 'n', 'v'])
        && validList(request.resource.data)
        && request.resource.data.n == 0;
      allow update: if validListId()
        && request.resource.data.keys().hasOnly(['d', 'owner', 'n', 'v', 'proof'])
        && validList(request.resource.data)
        && request.resource.data.proof is string
        && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && hashing.sha256(request.resource.data.proof).toHexString().lower() == resource.data.owner
        && request.resource.data.n == resource.data.n + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
