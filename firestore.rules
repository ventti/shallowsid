rules_version = '2';

// ShallowSID sync: one document per sync key, at vaults2/<64 hex id>.
// The id and a write secret are derived from a 128-bit key that only the
// user's devices know, and the content is encrypted in the browser, so there
// are no accounts. Knowing the id lets you read the ciphertext, nothing more:
// like lists/ below, `owner` is sha256(token_n) and an update must carry
// proof = token_n, bump n and store owner = sha256(token_n+1), where token_n
// comes from the write secret. Deleting takes a proven update that sets
// `del` first. Listing is forbidden, so ids can't be discovered.
// v 2 marks a "moved" record, left when a device is removed from sync (see
// js/sync.js). It can't be changed or deleted, so the removed device, which
// still knows the old key, can't hide from the others where the data went.
// vaults/ holds records from before write proofs: read-only, for migration.
service cloud.firestore {
  match /databases/{database}/documents {
    function validVaultId(id) {
      return id.matches('^[0-9a-f]{64}$');
    }

    match /vaults/{id} {
      allow get: if validVaultId(id);
      allow list, create, update, delete: if false;
    }

    match /vaults2/{id} {
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['c', 'iv', 'v', 'expireAt', 'owner', 'n', 'proof', 'del'])
          && d.c is string && d.c.size() <= 500000
          && d.iv is string && d.iv.size() == 16
          && d.v is int
          && d.expireAt is timestamp
          && d.expireAt > request.time
          && d.expireAt < request.time + duration.value(400, 'd')
          && d.owner is string && d.owner.matches('^[0-9a-f]{64}$')
          && d.n is int
          && (!('del' in d) || d.del is bool);
      }

      function proven() {
        let d = request.resource.data;
        return d.proof is string && d.proof.matches('^[0-9a-f]{64}$')
          && hashing.sha256(d.proof).toHexString().lower() == resource.data.owner
          && d.n == resource.data.n + 1;
      }

      allow get: if validVaultId(id);
      allow list: if false;
      allow create: if validVaultId(id) && validData()
        && request.resource.data.n == 0
        && !('proof' in request.resource.data)
        && !('del' in request.resource.data);
      allow update: if validVaultId(id) && validData() && proven()
        && resource.data.v < 2
        && resource.data.get('del', false) == false;
      allow delete: if validVaultId(id) && resource.data.get('del', false) == true;
    }

    // Unlisted playlists: lists/<12-char id>, readable by anyone with the link.
    // Only the owner can change one: `owner` is sha256(token_n), and an update
    // must carry proof = token_n and store owner = sha256(token_n+1), so a proof
    // that becomes visible after use is useless for the next update.
    // "Stop sharing" is such an update with empty content; there is no delete.
    match /lists/{id} {
      function validListId() {
        return id.matches('^[a-hj-np-z2-9]{12}$');
      }

      function validList(d) {
        return d.d is string && d.d.size() <= 200000
          && d.owner is string && d.owner.matches('^[0-9a-f]{64}$')
          && d.n is int
          && d.v is int;
      }

      allow get: if validListId();
      allow list, delete: if false;
      allow create: if validListId()
        && request.resource.data.keys().hasOnly(['d', 'owner', 'n', 'v'])
        && validList(request.resource.data)
        && request.resource.data.n == 0;
      allow update: if validListId()
        && request.resource.data.keys().hasOnly(['d', 'owner', 'n', 'v', 'proof'])
        && validList(request.resource.data)
        && request.resource.data.proof is string
        && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && hashing.sha256(request.resource.data.proof).toHexString().lower() == resource.data.owner
        && request.resource.data.n == resource.data.n + 1;
    }

    // ---- tune tags (see js/tags-core.js) ----------------------------------
    // Anyone can read tags. Only active curators can set them, and only the
    // ids in tagIds() below are accepted, so there is no free text. Curators have no accounts: curators/<cid> holds a
    // proof chain like lists/ above, and each curator write is one batch that
    // also moves the writer's chain on, which stepped() checks with
    // get() (before the batch) and getAfter() (after it).
    // Roles: "curator" tags; "admin" also invites curators and turns them
    // off and on again.
    // Admins come only from invites made with tools/curators.py, which uses
    // IAM credentials and isn't bound by these rules.
    // Generated from js/tags-vocab.json (tags and retired ids) by
    // tools/build_rules.py; edit the JSON and run it, don't edit here.
    // BEGIN TAG IDS
    function tagIds() {
      return [
        'acid',
        'acid-house',
        'acid-jazz',
        'alternative',
        'ambient',
        'arabic',
        'balkan',
        'ballad',
        'blues',
        'bossa-nova',
        'celtic',
        'childrens',
        'christmas',
        'classical',
        'country',
        'cumbia',
        'disco',
        'drum-and-bass',
        'dub',
        'electro',
        'eurodance',
        'experimental',
        'fake-music',
        'folk',
        'funk',
        'fusion',
        'gabber',
        'glitch',
        'hardcore',
        'hardstep',
        'hip-hop',
        'house',
        'humppa',
        'industrial',
        'italo-disco',
        'jazz',
        'jungle',
        'krautrock',
        'latin',
        'mambo',
        'mariachi',
        'metal',
        'minimalistic',
        'muzak',
        'noise',
        'novelty',
        'oriental',
        'phonk',
        'polka',
        'pop',
        'prank',
        'prog',
        'psychedelic',
        'rnb',
        'ragtime',
        'reggae',
        'rock',
        'soul',
        'synthpop',
        'tango',
        'techno',
        'theme',
        'traditional',
        'trance',
        'trap',
        'trip-hop',
        'tv-movie',
        'waltz',
        'aggressive',
        'bouncy',
        'calm',
        'cool',
        'cosmic',
        'dark',
        'downtempo',
        'dramatic',
        'dreamy',
        'eccentric',
        'energetic',
        'epic',
        'funny',
        'happy',
        'hypnotic',
        'melancholic',
        'melodic',
        'mysterious',
        'playful',
        'quirky',
        'spooky',
        'uptempo',
        'demo',
        'game-complete',
        'game-over',
        'high-score',
        'in-game',
        'intro',
        'jingle',
        'loader',
        'note',
        'title-tune',
        'arpeggios',
        'cover',
        'digi',
        'filter',
        'multispeed',
        'remix-classic',
        'speech'
      ];
    }
    // END TAG IDS

    function curatorDoc(cid) {
      return /databases/$(database)/documents/curators/$(cid);
    }

    function stepped(cid) {
      return cid is string && validVaultId(cid)
        && get(curatorDoc(cid)).data.active == true
        && getAfter(curatorDoc(cid)).data.n == get(curatorDoc(cid)).data.n + 1;
    }

    function adminStepped(cid) {
      return stepped(cid) && get(curatorDoc(cid)).data.role == 'admin';
    }

    function inviteDoc(h) {
      return /databases/$(database)/documents/invites/$(h);
    }

    match /curators/{cid} {
      allow get: if validVaultId(cid);
      allow list, delete: if false;
      // Joining: the batch marks a valid, unused invite as used by this id.
      allow create: if validVaultId(cid)
        && request.resource.data.keys().hasOnly(['owner', 'n', 'role', 'active', 'invite'])
        && request.resource.data.owner is string && request.resource.data.owner.matches('^[0-9a-f]{64}$')
        && request.resource.data.n == 0
        && request.resource.data.active == true
        && request.resource.data.invite is string && validVaultId(request.resource.data.invite)
        && get(inviteDoc(request.resource.data.invite)).data.used == null
        && get(inviteDoc(request.resource.data.invite)).data.exp > request.time
        && request.resource.data.role == get(inviteDoc(request.resource.data.invite)).data.role
        && getAfter(inviteDoc(request.resource.data.invite)).data.used == cid;
      // A step of the curator's own chain.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['owner', 'n', 'proof'])
        && resource.data.active == true
        && request.resource.data.owner is string && request.resource.data.owner.matches('^[0-9a-f]{64}$')
        && request.resource.data.proof is string && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && hashing.sha256(request.resource.data.proof).toHexString().lower() == resource.data.owner
        && request.resource.data.n == resource.data.n + 1;
      // An admin turning a curator off, or back on (admins only with
      // tools/curators.py). A curator that's off can't step its chain, so
      // it can't tag or turn itself back on.
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['active', 'changedBy'])
        && request.resource.data.active is bool
        && resource.data.role == 'curator'
        && request.resource.data.changedBy != cid
        && adminStepped(request.resource.data.changedBy);
    }

    // invites/<sha256(secret)>: made by an admin, used once before `exp`.
    match /invites/{h} {
      allow get: if validVaultId(h);
      allow list, delete: if false;
      allow create: if validVaultId(h)
        && request.resource.data.keys().hasOnly(['role', 'by', 'exp', 'used'])
        && request.resource.data.role == 'curator'
        && request.resource.data.used == null
        && request.resource.data.exp is timestamp
        && request.resource.data.exp > request.time
        && request.resource.data.exp < request.time + duration.value(15, 'd')
        && adminStepped(request.resource.data.by);
      // Used: the secret shows it was known; it's worthless once used.
      allow update: if resource.data.used == null
        && resource.data.exp > request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used', 'secret'])
        && request.resource.data.secret is string
        && hashing.sha256(request.resource.data.secret).toHexString().lower() == h
        && request.resource.data.used is string && validVaultId(request.resource.data.used)
        && getAfter(curatorDoc(request.resource.data.used)).data.invite == h;
      // Expired early by an admin while still waiting: exp becomes now, so
      // it can't be used any more. Admin invites are left to tools/curators.py.
      allow update: if resource.data.used == null
        && resource.data.exp > request.time
        && resource.data.role == 'curator'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['exp', 'cancelledBy'])
        && request.resource.data.exp == request.time
        && adminStepped(request.resource.data.cancelledBy);
    }

    // tags/<sha256("path#s")>: s = 0 is the whole tune, s >= 1 a subtune.
    // b, if there, is the tempo in whole BPM (js/tags-core.js MIN_BPM..MAX_BPM),
    // or 0 for "no tempo", which hides the estimate.
    match /tags/{id} {
      function validTags() {
        let d = request.resource.data;
        return d.keys().hasOnly(['p', 's', 't', 'b', 'by', 'at'])
          && d.p is string && d.p.size() <= 255
          && d.p.matches('^(MUSICIANS|GAMES|DEMOS)/[^<>"`\\\\]+[.]sid$')
          && !d.p.matches('.*(^|/)[.][.]?(/|$).*')
          && d.s is int && d.s >= 0 && d.s <= 256
          && hashing.sha256(d.p + '#' + string(d.s)).toHexString().lower() == id
          && d.t is list && d.t.size() <= 12
          && d.t.hasOnly(tagIds())
          && (!('b' in d) || (d.b is int && (d.b == 0 || (d.b >= 20 && d.b <= 300))))
          && d.at == request.time
          && stepped(d.by);
      }

      allow get, list: if true;
      allow create, update: if validVaultId(id) && validTags();
      allow delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
