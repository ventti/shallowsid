rules_version = '2';

// ShallowSID sync: one document per sync key, at vaults/<64 hex id>.
// The id is derived from a 128-bit key that only the user's devices know, and
// the content is encrypted in the browser, so there are no accounts: knowing
// the id is the permission. Listing is forbidden, so ids can't be discovered.
service cloud.firestore {
  match /databases/{database}/documents {
    match /vaults/{id} {
      function validId() {
        return id.matches('^[0-9a-f]{64}$');
      }

      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['c', 'iv', 'v', 'expireAt'])
          && d.c is string && d.c.size() <= 500000
          && d.iv is string && d.iv.size() == 16
          && d.v is int
          && d.expireAt is timestamp
          && d.expireAt > request.time
          && d.expireAt < request.time + duration.value(400, 'd');
      }

      allow get, delete: if validId();
      allow create, update: if validId() && validData();
      allow list: if false;
    }

    // Unlisted playlists: lists/<12-char id>, readable by anyone with the link.
    // Only the owner can change one: `owner` is sha256(token_n), and an update
    // must carry proof = token_n and store owner = sha256(token_n+1), so a proof
    // that becomes visible after use is useless for the next update.
    // "Stop sharing" is such an update with empty content; there is no delete.
    match /lists/{id} {
      function validListId() {
        return id.matches('^[a-hj-np-z2-9]{12}$');
      }

      function validList(d) {
        return d.d is string && d.d.size() <= 200000
          && d.owner is string && d.owner.matches('^[0-9a-f]{64}$')
          && d.n is int
          && d.v is int;
      }

      allow get: if validListId();
      allow list, delete: if false;
      allow create: if validListId()
        && request.resource.data.keys().hasOnly(['d', 'owner', 'n', 'v'])
        && validList(request.resource.data)
        && request.resource.data.n == 0;
      allow update: if validListId()
        && request.resource.data.keys().hasOnly(['d', 'owner', 'n', 'v', 'proof'])
        && validList(request.resource.data)
        && request.resource.data.proof is string
        && request.resource.data.proof.matches('^[0-9a-f]{64}$')
        && hashing.sha256(request.resource.data.proof).toHexString().lower() == resource.data.owner
        && request.resource.data.n == resource.data.n + 1;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
